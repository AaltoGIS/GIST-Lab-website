---
import { Picture } from "astro:assets";
import { getEntry, render } from "astro:content";
import Base from "../layouts/Base.astro";
import { withBase } from "../lib/paths";

const home = await getEntry("home", "home");
if (!home) throw new Error("content/home.md is missing");
const { hero } = home.data;
const { Content } = await render(home);
---

<Base title={home.data.title} description={home.data.description} overlayHeader>
  <section class="hero">
    <Picture
      class="hero__image"
      src={hero.image}
      alt={hero.imageAlt}
      widths={[768, 1280, 1920, 2560, hero.image.width]}
      sizes="100vw"
      formats={["avif", "webp"]}
      loading="eager"
      fetchpriority="high"
      style={`object-position: ${hero.imagePosition}`}
    />
    <div class="hero__shade" aria-hidden="true"></div>
    <div class="container hero__content">
      <h1 class="hero__title">{hero.title}</h1>
      <p class="hero__text">{hero.text}</p>
      {hero.actions.length > 0 && (
        <div class="hero__actions">
          {hero.actions.map((action, index) => (
            <a class:list={["button", index === 0 ? "button--primary" : "button--ghost"]} href={withBase(action.href)}>{action.label}</a>
          ))}
        </div>
      )}
    </div>
    {hero.credit && <p class="hero__credit">{hero.credit}</p>}
  </section>

  <section class="section">
    <div class="container prose prose--lead">
      <Content />
    </div>
  </section>
</Base>
