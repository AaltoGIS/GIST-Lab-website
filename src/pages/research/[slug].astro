---
import { Image } from "astro:assets";
import { getEntries, getEntry, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import NewsCard from "../../components/NewsCard.astro";
import { pageLabel } from "../../lib/labels";
import { getNews } from "../../lib/news";
import { withBase } from "../../lib/paths";
import { displayName } from "../../lib/people";
import { getProjects, projectName, projectSummary, type Project } from "../../lib/projects";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.filter((project) => project.data.page).map((project) => ({ params: { slug: project.id }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { data } = project;
const page = await getEntry("pages", "research");
if (!page) throw new Error("content/pages/research.md is missing");
const { Content } = await render(project);
const team = await getEntries(data.team);
const news = (await getNews()).filter((post) => post.data.projects.some((ref) => ref.id === project.id));
const facts = [
  ["years", data.years],
  ["funders", data.funders.join(", ")],
  ["pi", data.pi],
  ["coordinator", data.coordinator]
].filter(([, value]) => value) as [string, string][];
---

<Base title={projectName(project)} description={projectSummary(project)}>
  <article class="section">
    <div class="container">
      <header class="project-header">
        {data.logo && <Image class="project-header__logo" src={data.logo} alt={data.logoAlt ?? ""} widths={[200, 400]} sizes="8rem" />}
        <div>
          <p class="eyebrow"><a href={withBase("/research/")}>{page.data.title}</a></p>
          <h1>{data.title}</h1>
        </div>
      </header>

      <div class="project-layout">
        <div class="prose project-body"><Content /></div>
        <aside class="project-aside">
          <dl class="project-facts">
            {facts.map(([key, value]) => (
              <>
                <dt>{pageLabel(page, key)}</dt>
                <dd>{value}</dd>
              </>
            ))}
            {data.website && (
              <>
                <dt>{pageLabel(page, "website")}</dt>
                <dd><a href={data.website}>{data.website.replace(/^https?:\/\//, "").replace(/\/$/, "")}</a></dd>
              </>
            )}
          </dl>
          {team.length > 0 && (
            <section class="project-team">
              <h2>{pageLabel(page, "team")}</h2>
              <ul>
                {team.map((person) => (
                  <li>
                    {person.data.photo && <Image src={person.data.photo} alt="" widths={[80, 160]} sizes="2.5rem" style={`object-position: ${person.data.photoPosition}`} />}
                    {person.data.group === "former" ? displayName(person) : <a href={withBase(`/people/${person.id}/`)}>{displayName(person)}</a>}
                  </li>
                ))}
              </ul>
            </section>
          )}
        </aside>
      </div>

      {news.length > 0 && (
        <section class="project-news">
          <h2>{pageLabel(page, "news")}</h2>
          <div class="news-grid">{news.map((post) => <NewsCard post={post} />)}</div>
        </section>
      )}
    </div>
  </article>
</Base>
