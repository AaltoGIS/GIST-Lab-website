---
import { formatDateRange, isoDay } from "../lib/dates";
import { withBase } from "../lib/paths";
import type { LabEvent } from "../lib/events";

interface Props {
  event: LabEvent;
}

const { event } = Astro.props;
const { data } = event;
const day = data.date ? new Intl.DateTimeFormat("en-GB", { day: "numeric", timeZone: "UTC" }).format(data.date) : "";
const month = data.date ? new Intl.DateTimeFormat("en-GB", { month: "short", year: "numeric", timeZone: "UTC" }).format(data.date) : "";
---

<article class="event-item">
  <div class="event-item__date" aria-hidden="true">
    {data.date ? (
      <>
        <span class="event-item__day">{day}</span>
        <span class="event-item__month">{month}</span>
      </>
    ) : (
      <span class="event-item__month">–</span>
    )}
  </div>
  <div class="event-item__body">
    <h3 class="event-item__title"><a href={withBase(`/events/${event.id}/`)}>{data.title}</a></h3>
    <p class="event-item__meta">
      {data.date && <time datetime={isoDay(data.date)}>{formatDateRange(data.date, data.endDate)}</time>}
      {data.date && data.location && " · "}
      {data.location}
    </p>
  </div>
</article>
