---
import { getEntry, render } from "astro:content";
import Base from "../layouts/Base.astro";

const home = await getEntry("home", "home");
if (!home) throw new Error("content/home.md is missing");
const { Content } = await render(home);
---

<Base title={home.data.title} description={home.data.description}>
  <section class="section">
    <div class="container prose prose--lead">
      <h1>{home.data.title}</h1>
      <Content />
    </div>
  </section>
</Base>
