---
import { withBase } from "../lib/paths";
import { eventDates, type LabEvent } from "../lib/events";

interface Props {
  event: LabEvent;
}

const { event } = Astro.props;
const { data } = event;
const dates = eventDates(event);
// The date box shows day and month, or month and year for events dated by month.
const format = (options: Intl.DateTimeFormatOptions) => (data.date ? new Intl.DateTimeFormat("en-GB", { ...options, timeZone: "UTC" }).format(data.date) : "");
const day = data.byMonth ? format({ month: "short" }) : format({ day: "numeric" });
const month = data.byMonth ? format({ year: "numeric" }) : format({ month: "short", year: "numeric" });
---

<article class="event-item">
  <div class="event-item__date" aria-hidden="true">
    {data.date ? (
      <>
        <span class="event-item__day">{day}</span>
        <span class="event-item__month">{month}</span>
      </>
    ) : (
      <span class="event-item__month">–</span>
    )}
  </div>
  <div class="event-item__body">
    <h3 class="event-item__title"><a href={withBase(`/events/${event.id}/`)}>{data.title}</a></h3>
    <p class="event-item__meta">
      {dates && <time datetime={dates.datetime}>{dates.text}</time>}
      {dates && data.location && " · "}
      {data.location}
    </p>
  </div>
</article>
