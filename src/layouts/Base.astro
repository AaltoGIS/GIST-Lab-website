---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import { getEntry } from "astro:content";
import "@fontsource-variable/montserrat";
import "@fontsource-variable/open-sans";
import "@fontsource-variable/open-sans/wght-italic.css";
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { site } from "../lib/site";
import { withBase } from "../lib/paths";

interface Props {
  title: string;
  description?: string;
  /** Header drawn over the first section (a full-width banner image). */
  overlayHeader?: boolean;
  /** Preview image for link previews (Open Graph); the front-page banner when omitted. */
  image?: ImageMetadata;
  noindex?: boolean;
}

const { title, description = site.description, overlayHeader = false, image, noindex = false } = Astro.props;
const fullTitle = title === site.name ? `${site.name} – ${site.fullName}` : `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
// SVG logos cannot be turned into a preview photo; the banner is used instead.
const previewSource = image && image.format !== "svg" ? image : (await getEntry("home", "home"))?.data.hero.image;
const preview = previewSource ? await getImage({ src: previewSource, width: 1200, format: "jpg" }) : undefined;
const previewUrl = preview ? new URL(preview.src, Astro.site).toString() : undefined;
const newsTitle = (await getEntry("pages", "news"))?.data.title;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={site.name} />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        {previewUrl && <meta property="og:image" content={previewUrl} />}
        <meta name="twitter:card" content={previewUrl ? "summary_large_image" : "summary"} />
      </>
    )}
    <link rel="sitemap" href={withBase("/sitemap-index.xml")} />
    {newsTitle && <link rel="alternate" type="application/rss+xml" title={`${site.name} – ${newsTitle}`} href={withBase("/news/rss.xml")} />}
    <link rel="icon" href={withBase("/gist-mark.svg")} type="image/svg+xml" />
    <script is:inline>
      // The site opens dark; a visitor's own choice from the theme toggle wins.
      try {
        if (localStorage.getItem("theme") === "light") document.documentElement.dataset.theme = "light";
      } catch {
        // Storage unavailable: stay dark.
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{site.labels.skipToContent}</a>
    <SiteHeader overlay={overlayHeader} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
