---
import { getEntry, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { pageLabel } from "../../lib/labels";
import { getProjects } from "../../lib/projects";

const page = await getEntry("pages", "research");
if (!page) throw new Error("content/pages/research.md is missing");
const { Content } = await render(page);
const projects = await getProjects();
const sections = (["ongoing", "past"] as const)
  .map((status) => ({ status, items: projects.filter((project) => project.data.status === status) }))
  .filter(({ items }) => items.length > 0);
---

<Base title={page.data.title} description={page.data.description}>
  <section class="section page-intro">
    <div class="container">
      <h1>{page.data.title}</h1>
      <div class="prose prose--lead"><Content /></div>
    </div>
  </section>

  {sections.map(({ status, items }) => (
    <section class="section section--tight">
      <div class="container">
        <h2>{pageLabel(page, status)}</h2>
        <div class="project-grid">
          {items.map((project) => <ProjectCard project={project} />)}
        </div>
      </div>
    </section>
  ))}
</Base>
